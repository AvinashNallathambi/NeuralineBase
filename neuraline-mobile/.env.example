# Neuraline Mobile — Environment Variables
# Copy to .env and fill in values for your environment.

# Backend API URL (absolute — no relative paths in native apps)
API_URL=http://localhost:4000/api/v1

# App version (sent as X-App-Version header for force-update support)
APP_VERSION=1.0.0

# Sentry DSN (optional — if empty, Sentry is not initialized)
SENTRY_DSN=

# WebRTC TURN servers (JSON array of RTCIceServer configs)
# In production, use your coturn server credentials
TURN_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]

# Stripe publishable key (for PaymentSheet)
STRIPE_PUBLISHABLE_KEY=
